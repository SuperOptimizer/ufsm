#!/bin/sh
# ptxas wrapper for clang -x cuda (--ptxas-path; generated by CMakeLists.txt from cmake/ptxas.sh.in): raise the PTX ISA version
# clang writes to @UFSM_PTX_ISA@ before assembling. LLVM 22 emits at most `.version 9.0`; the MX-fp4 block-scaled mma with
# .scale_vec::4X and .ue8m0 scales (lp_*) needs PTX ISA 9.1 (CUDA 13.1+). PTX ISA versions are backward compatible, so only the
# header line changes.
for a in "$@"; do
  case $a in
    *.s|*.ptx) [ -f "$a" ] && sed -i 's/^\.version \([0-8]\.[0-9]*\|9\.0\)$/.version @UFSM_PTX_ISA@/' "$a";;
  esac
done
exec "@UFSM_CUDA@/bin/ptxas" "$@"
