# The LLVM toolchain (CMakePresets.json passes this as the toolchain file; CMakeLists.txt uses it when none is given).
# clang / clang++ for C23 and the CUDA units (clang -x cuda), lld, llvm-ar / ranlib / nm / objcopy / objdump / strip, compiler-rt
# builtins and crt files (CMakeLists.txt, UFSM_LLVM_RUNTIME): no gcc, g++ or GNU binutils anywhere in the build.
# The newest clang wins: plain `clang` (the desk: llvm-22 is the default), else clang-N for N = 30..20 (the pods: apt.llvm.org's
# clang-22 next to Ubuntu's gcc). UFSM_LLVM_ROOT=/usr/lib/llvm-N pins one.
if(NOT UFSM_LLVM_ROOT)
  set(_names clang)
  foreach(v RANGE 30 20 -1)
    list(APPEND _names clang-${v})
  endforeach()
  set(_best "")
  set(_bestv 0)
  foreach(n ${_names})
    find_program(_c NAMES ${n} NO_CACHE)
    if(_c)
      execute_process(COMMAND ${_c} -dumpversion OUTPUT_VARIABLE _v OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
      if(_v VERSION_GREATER _bestv)
        set(_bestv ${_v})
        set(_best ${_c})
      endif()
    endif()
    unset(_c)
  endforeach()
  if(NOT _best)
    message(FATAL_ERROR "llvm.cmake: no clang found (apt install clang-22 lld-22 llvm-22 libclang-rt-22-dev)")
  endif()
  # the real install prefix (/usr/bin/clang -> /usr/lib/llvm-N/bin/clang): every tool is taken from the same LLVM
  get_filename_component(_real ${_best} REALPATH)
  get_filename_component(_bin ${_real} DIRECTORY)
  get_filename_component(UFSM_LLVM_ROOT ${_bin} DIRECTORY)
  set(UFSM_LLVM_ROOT ${UFSM_LLVM_ROOT} CACHE PATH "LLVM install prefix (/usr/lib/llvm-N)")
endif()
set(_b ${UFSM_LLVM_ROOT}/bin)
set(CMAKE_C_COMPILER ${_b}/clang)
set(CMAKE_CXX_COMPILER ${_b}/clang++)
set(CMAKE_AR ${_b}/llvm-ar CACHE FILEPATH "")
set(CMAKE_RANLIB ${_b}/llvm-ranlib CACHE FILEPATH "")
set(CMAKE_NM ${_b}/llvm-nm CACHE FILEPATH "")
set(CMAKE_OBJCOPY ${_b}/llvm-objcopy CACHE FILEPATH "")
set(CMAKE_OBJDUMP ${_b}/llvm-objdump CACHE FILEPATH "")
set(CMAKE_STRIP ${_b}/llvm-strip CACHE FILEPATH "")
set(CMAKE_READELF ${_b}/llvm-readelf CACHE FILEPATH "")
set(CMAKE_ADDR2LINE ${_b}/llvm-addr2line CACHE FILEPATH "")
set(CMAKE_LINKER ${_b}/ld.lld CACHE FILEPATH "")
# lld for every link (CMAKE_LINKER_TYPE needs CMake 3.29; the pods have 3.28)
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld")
