# cmake -DSRC=<src dir> -DOUT=<file.c> -P optnames.cmake: every "--name" string literal in the sources (and the opt_p("--prefix")
# families) as a C table, so main() can refuse a --flag that no command of this binary knows before any work (src/optcheck.h:
# opt_unknown). A literal with printf conversions ("--aug-%s-p") is a pattern: each conversion matches any run of characters.
file(GLOB _f ${SRC}/*.c ${SRC}/*.h ${SRC}/*.cu ${SRC}/*.cuh)
set(_names)
set(_pref)
foreach(f ${_f})
  file(READ ${f} _t)
  string(REGEX MATCHALL "\"--[A-Za-z0-9][A-Za-z0-9_%.-]*" _m "${_t}")
  foreach(m ${_m})
    string(SUBSTRING "${m}" 1 -1 m)
    list(APPEND _names "${m}")
  endforeach()
  string(REGEX MATCHALL "opt_p\\(\"--[^\"]*\"\\)" _p "${_t}")
  foreach(p ${_p})
    string(REGEX REPLACE "opt_p\\(\"(--[^\"]*)\"\\)" "\\1" p "${p}")
    list(APPEND _pref "${p}")
  endforeach()
endforeach()
list(REMOVE_DUPLICATES _names)
list(SORT _names)
list(REMOVE_DUPLICATES _pref)
list(SORT _pref)
list(LENGTH _names _nn)
list(LENGTH _pref _np)
set(_o "/* generated by cmake/optnames.cmake: do not edit */\n#include <stddef.h>\nconst char *const ufsm_opt_names[] = {\n")
foreach(n ${_names})
  string(APPEND _o "    \"${n}\",\n")
endforeach()
string(APPEND _o "    nullptr};\nconst int ufsm_opt_nnames = ${_nn};\nconst char *const ufsm_opt_prefixes[] = {\n")
foreach(p ${_pref})
  string(APPEND _o "    \"${p}\",\n")
endforeach()
string(APPEND _o "    nullptr};\nconst int ufsm_opt_nprefixes = ${_np};\n")
if(EXISTS ${OUT})
  file(READ ${OUT} _old)
  if(_old STREQUAL _o)
    return()
  endif()
endif()
file(WRITE ${OUT} "${_o}")
