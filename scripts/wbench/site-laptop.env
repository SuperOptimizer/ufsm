# wbench site: the laptop (RTX 5080 16 GB). Sourced by wbench.sh.
WB=${WB:-$HOME/ufsm-data/wbench}
MIRROR=https://dl.ash2txt.org/community-uploads/forrest/volcomp
P4ROOT=$WB/volcomp                     # the desk's pooled Paris 4 level 2 (production fields came from it), z band 8448..14464 copied
GT=$WB/gt                              # label copies (box shards; whole for 0139 / 0814 / 0500P2; Paris 4 q-9p6 whole)
AXP4=$WB/gt/axis-paris4.json           # = desk /vesuvius/ufsm/paris4/ckpt/axis-0.json
AX1667=$WB/gt/umbilicus-1667.json      # = desk /vesuvius/ufsm/umbilicus/PHerc1667/umbilicus-full-resolution.json
CACHE=$WB/cache                        # HTTP chunk cache (1667, 0139, 0814, 0500P2 CT from the mirror)
LOCK=${LOCK:-$HOME/ufsm-data/gpu.lock} # flock around the whole run
THREADS=${THREADS:-12}
RUN() { env MEM=${MEMJ:-12G} $HOME/ufsm-data/capped.sh "$@"; }   # every heavy command (laptop memory rule)
RUNBIG() { env MEM=${MEMBIG:-30G} $HOME/ufsm-data/capped.sh "$@"; }   # full-section slab fits / site predicts
P4JQ=$WB/gt/paris4-july/codesB         # not copied: the paris4j boxes lie outside the laptop CT band; run them on the desk
