# wbench / wgate site: forlindesk (2 x RTX 3090 24 GB, 60 GB RAM: keep under ~50 GB; 24 cores). Sourced by wbench.sh / wgate.sh.
# GPU 1 first (GPU 0 fell off the bus once; power limit 225 W after every reboot: sudo -n nvidia-smi -pl 225). Binary: an sm_86 build
# (make ARCH=86 BDIR=build CUDA=/usr/local/cuda-13.4) pinned in $WB/bin; its emulated MX predict differs from the 5080 in the last
# bits, so the baseline is wind96 re-run HERE (REF=wind96fd, $WB/gate/wind96fd), not the laptop rows.
WB=${WB:-/vesuvius/ufsm/wgate}
MIRROR=https://dl.ash2txt.org/community-uploads/forrest/volcomp
P4ROOT=/vesuvius/ufsm/volcomp          # Paris 4 2.4 um levels 2-9
GT=$WB/gt                              # the laptop wbench GT subset (fdsync.sh): paris4-q9p6, paris4-wind-20261019 phaseA/B, paris4-july, PHerc1667
AXP4=$WB/gt/axis-paris4.json
AX1667=$WB/gt/umbilicus-1667.json
CACHE=$WB/cache                        # HTTP chunk cache (1667 CT; seeded from the laptop)
LOCK=${LOCK:-$WB/gpu$GPU.lock}         # one gpuq per GPU ($WB/gpu$GPU.q)
THREADS=${THREADS:-12}
RUN() { nice -n 5 "$@"; }
RUNBIG() { nice -n 5 "$@"; }
P4JQ=$WB/gt/paris4-july/codesB
