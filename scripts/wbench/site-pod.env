# wbench site: a pod built by scripts/pod/datakit.sh (labels rebuilt from the public segments under $K; CT over HTTP from the volcomp mirror
# with a local chunk cache). Sourced by wbench.sh. K = the datakit tree (default /workspace/kit).
K=${K:-/workspace/kit}
WB=${WB:-$K/wb}
MIRROR=https://dl.ash2txt.org/community-uploads/forrest/volcomp
P4ROOT=$MIRROR; P4V=PHercParis4/volumes/20260411134726-2.400um-0.2m-78keV-masked.zarr   # the mirror keeps scans under <scroll>/volumes/
GT=$K/wbgt                             # paris4-q9p6/q-9p6.zarr, paris4-wind-20261019/phaseA -> $K/gt/paris4 (datakit.sh links)
AXP4=$K/small/axis/paris4-axis-0.json
AX1667=$K/small/axis/PHerc1667-umbilicus.json
CACHE=${CACHE:-$K/cache}
LOCK=${LOCK:-$WB/gpu$GPU.lock}
THREADS=${THREADS:-12}
# shared pod GPU ($K/GPU.md when present): a predict is one shared unit: it waits while $K/gpu.pause exists (an exclusive timing slot or
# request) and marks $K/gpu.shared/eval-<pid> while it runs, so a timing job gets the card between two predicts (seconds to a minute)
# instead of after a whole eval step. Fits and scores are CPU work and never wait.
RUN() { if [ "${2:-}" = predict ] && [ -d $K/gpu.shared ]; then while [ -e $K/gpu.pause ]; do sleep 5; done; touch $K/gpu.shared/eval-$$
    nice -n 5 "$@"; local rc=$?; rm -f $K/gpu.shared/eval-$$; return $rc; fi; nice -n 5 "$@"; }
RUNBIG() { RUN "$@"; }
P4JQ=$K/gt/paris4/codesB               # July codes (= desk wbench/gtjuly/codesB)
