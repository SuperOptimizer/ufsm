# wbench site: a pod built by scripts/pod/datakit.sh (labels rebuilt from the public segments under $K; CT over HTTP from the volcomp mirror
# with a local chunk cache). Sourced by wbench.sh. K = the datakit tree (default /workspace/kit).
K=${K:-/workspace/kit}
WB=${WB:-$K/wb}
MIRROR=${CTROOT:-https://dl.ash2txt.org/community-uploads/forrest/volcomp}   # CTROOT: another tree with the mirror's layout (e.g. a re-encoded CT sweep arm)
P4ROOT=$MIRROR; P4V=PHercParis4/volumes/20260411134726-2.400um-0.2m-78keV-masked.zarr   # the mirror keeps scans under <scroll>/volumes/
GT=$K/wbgt                             # paris4-q9p6/q-9p6.zarr, paris4-wind-20261019/phaseA -> $K/gt/paris4 (datakit.sh links)
AXP4=$K/small/axis/paris4-axis-0.json
AX1667=$K/small/axis/PHerc1667-umbilicus.json
CACHE=${CACHE:-$K/cache}
LOCK=${LOCK:-$WB/gpu$GPU.lock}
THREADS=${THREADS:-12}
# shared pod GPU ($K/GPU.md when present): a predict is one shared unit: it waits while $K/gpu.pause exists (an exclusive timing slot or
# request) and marks $K/gpu.shared/eval-<pid> while it runs, so a timing job gets the card between two predicts (seconds to a minute)
# instead of after a whole eval step. Fits use the GPU backend (the fitter config of every stored row), ~5 s each: units as well.
# fields-oracle / fit-compare / fit-join are CPU work and never wait.
# the shared window (GPU.md, 2026-11-12 10:40 UTC): shared units run in minutes :00-:20 and start no later than :15 (:40 / :35 while
# $K/gpu.gate-waiting exists, which podeval.sh holds during an eval); outside it gpu.pause exists.
gpuwin() { while [ -e $K/gpu.pause ] || [ $((10#$(date +%M))) -ge $([ -e $K/gpu.gate-waiting ] && echo 35 || echo 15) ]; do sleep 5; done; }
# fits (lead's decision 2026-11-12): outside the window too, beside the resident trainer, one at a time (the eval is sequential), device
# memory < 4 GB: each fit's peak is sampled into $K/fitmem.log, and one above 4096 MiB (or $K/fit.inwindow, set by hand when the fits cost
# the trainer > 10%) sends the following fits back into the window. They still wait for an exclusive claim (gpu.pause not "u2solo").
fitwait() { if [ -e $K/fit.inwindow ]; then gpuwin; else while [ -e $K/gpu.pause ] && [ "$(cat $K/gpu.pause 2>/dev/null)" != u2solo ]; do sleep 5; done; fi; }
RUN() { if [ "${2:-}" = predict ] && [ -d $K/gpu.shared ]; then gpuwin; touch $K/gpu.shared/eval-$$
    nice -n 5 "$@"; local rc=$?; rm -f $K/gpu.shared/eval-$$; return $rc; fi
  if [ "${2:-}" = fit ] && [ -d $K/gpu.shared ]; then fitwait; touch $K/gpu.shared/eval-$$
    nice -n 5 "$@" & local p=$! m=0 v; while kill -0 $p 2>/dev/null; do v=$(nvidia-smi --query-compute-apps=pid,used_memory --format=csv,noheader,nounits 2>/dev/null | awk -F', ' -v p=$p '$1 == p {print $2}')
      [ -n "$v" ] && [ "$v" -gt $m ] && m=$v; sleep 1; done; wait $p; local rc=$?; rm -f $K/gpu.shared/eval-$$
    echo "$(date -u +%H:%M:%S) $m MiB" >> $K/fitmem.log; [ $m -gt 4096 ] && echo "$m MiB" > $K/fit.inwindow; return $rc; fi
  nice -n 5 "$@"; }
RUNBIG() { RUN "$@"; }
P4JQ=$K/gt/paris4/codesB               # July codes (= desk wbench/gtjuly/codesB)
