# wbench site: forlindesk2 (2 x 5060 Ti 16 GB). Sourced by wbench.sh. Pick the GPU with GPU=0|1 (your own GPU: B = 0, C = 1).
WB=${WB:-/vesuvius/ufsm/wbench}
MIRROR=https://dl.ash2txt.org/community-uploads/forrest/volcomp
P4ROOT=/vesuvius/ufsm/volcomp          # pooled Paris 4 level 2 (complete)
GT=/vesuvius/ufsm/gt
AXP4=/vesuvius/ufsm/paris4/ckpt/axis-0.json
AX1667=/vesuvius/ufsm/umbilicus/PHerc1667/umbilicus-full-resolution.json
CACHE=$WB/cache
LOCK=${LOCK:-$WB/gpu$GPU.lock}
THREADS=${THREADS:-16}
RUN() { nice -n 5 "$@"; }
RUNBIG() { nice -n 5 "$@"; }
P4JQ=$WB/gtjuly/codesB                 # Paris 4 July codes (gtjuly/build.sh) for the paris4j boxes
