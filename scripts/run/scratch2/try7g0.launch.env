U=/vesuvius/ufsm/v2/lat/bin/ufsm.scratch2.8120a3a6+8a71e6a
MLR=0.003
ALR=0.0003
# try7 optimizer (main 11-15: admuon's ablation, NorMuon alone carries the gain: loss -0.017, wind4 -0.012, acc +0.025 vs control at 0.003;
# LARS added nothing consistent, dropped; normuon seed-8 confirmation pending, main says before launch if it fails). Muon 0.003 / AdamW 3e-4.
OPTX=--muon-tc 2 --normuon 1
# (11-14 decision, superseded 11-15: NorMuon + LARS)
#OPTX=--muon-tc 2 --normuon 1 --muon-lars 1
P=768
SPLITF=
SLOTS=12
WORKERS=10
ONFLYMB=768
ONFLYSLOTS=2
HEADSLABZ=16
STEPS=71000
XFLAGS=--gn-ema-warm 1000000000 --skip-empty 1 --skip-thr 0 --skip-margin 1 --echo-max 4 --accum 5 --holdout-guard 32 --stick-src 8 --snap-jitter 1 --edge-boost 1 --vox-cap 2 --stop-at-update 1
SRCJ=/vesuvius/ufsm/univ/scratch1/sources-scratch1-ph80-ho.json
UW=0
WARM=1000
VAL=500
VALB=32
# one card (user 11-15 ~11:50: train on card 0, card 1 for mcc): CUDA_VISIBLE_DEVICES=0 via GPU=0, card-0 locks only; the onfly phase /
# fibre / ink paths default to the run's first GPU (= card 0)
GPU=0
LOCK=/vesuvius/ufsm/opt/gpu0.lock,/tmp/ufsm-suite-locks/gpu0.0,/tmp/ufsm-suite-locks/gpu0.1,/tmp/ufsm-suite-locks/gpu0.excl
FIBGPU=0
INKGPU=0
# (12:44 dry start: the trainer reached 135.5 GB host and died rc 1 in the 150 GB train slice with try6's 24 slots / 16 workers + the val sampler; one card halves the window rate, so 12 / 10)
# (15:3x: 32 x 4.98 GB = 159.5 GB of val windows on /vesuvius (diskclean at 91-95 %): regen, the same windows drawn at each pass)
VALSTORE=regen
